# 공공데이터포털(data.go.kr) 서비스 키
# 마이페이지 > 인증키에서 발급받은 "Decoding" 키
SERVICE_KEY=

# --- MySQL 데이터베이스 접속 정보 ---
DB_HOST=      # DB 주소 
DB_PORT=      # 포트 (기본 3306)
DB_NAME=      # 데이터베이스 이름 
DB_USER=      # 접속 계정 
DB_PASSWORD=  # 계정 비밀번호 

# --- 공공데이터 API 요청 시 보내는 앱 정보 ---
MOBILE_OS=    # 운영체제 (AND / IOS / ETC 중 하나, 보통 ETC)
MOBILE_APP=   # 앱 이름 (아무 값이나)
