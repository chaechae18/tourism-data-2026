# Copy to backend/.env and fill in. Never commit .env.
#
# 현재 backend/ 에는 스팟 API(FastAPI)와 홈 화면 API(Django) 두 스택이 공존합니다.
# 두 서버가 같은 .env 를 읽으므로 필요한 쪽 값만 채워도 나머지는 무시됩니다.

# ============================================================
# 스팟 API (FastAPI) — app/
# ============================================================

# Kakao Developers > 앱 > 플랫폼 키에서 발급한 REST API 키
KAKAO_REST_API_KEY=

# Naver Developers > 애플리케이션 > 검색 API 인증 정보
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# backend/ 기준 상대 경로 또는 절대 경로
DATABASE_PATH=./data/play_gyeongju.db

# 로컬 이미지 업로드 디렉터리와 최대 크기(byte)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# 장소 검색 캐시(초)와 IP별 요청 제한
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW_SECONDS=60

# 로그인/관리자 인증 도입 전 로컬 검수 API용 임시 키
ADMIN_API_KEY=

# 쉼표로 구분한 프론트엔드 origin 목록
CORS_ORIGINS=http://localhost:3000

# ============================================================
# 홈 화면 API (Django) — config/ core/ main/ tourapi/
# ============================================================

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Team-owned MySQL schema. Leave DB_NAME empty to fall back to a local
# SQLite file, which is enough to boot the server without MySQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Next.js dev server. FastAPI 쪽 CORS_ORIGINS 와 이름만 다르고 역할은 같습니다.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 한국관광공사 TourAPI (공공데이터포털에서 발급받은 일반 인증키, Decoding 값)
TOURAPI_SERVICE_KEY=
TOURAPI_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOURAPI_MOBILE_APP=PlayGyeongju
# 경상북도(35) / 경주시(2) - areaBasedList2(관광지)용
TOURAPI_AREA_CODE=35
TOURAPI_SIGUNGU_CODE=2
# 경상북도(47) / 경주시(130) - searchFestival2(축제)용 법정동 코드
TOURAPI_LDONG_REGN_CD=47
TOURAPI_LDONG_SIGNGU_CD=130
