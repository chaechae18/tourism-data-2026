# Kakao Developers > 앱 > 플랫폼 키에서 발급한 REST API 키
KAKAO_REST_API_KEY=

# Naver Developers > 애플리케이션 > 검색 API 인증 정보
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 팀에서 전달받은 Aiven 접속 정보. Docker도 이 값을 그대로 사용한다.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# 인증서와 호스트명을 검증하는 TLS 연결. 별도 CA가 필요하면 인증서 경로를 지정한다.
DB_SSL=true
DB_SSL_CA=
# 직접 실행 시에도 자동 스키마 변경을 하지 않는다. Docker에서는 항상 false다.
DB_AUTO_MIGRATE=false

# 선택적인 로컬 DB 컨테이너용 값. Compose 보간에는 루트 .env 또는 셸 환경을 사용한다.
MYSQL_DATABASE=play_gyeongju
MYSQL_USER=play_gyeongju
MYSQL_PASSWORD=123
MYSQL_ROOT_PASSWORD=123

# 공공데이터포털에서 발급받은 일반 인증키(Decoding 값)
TOURAPI_SERVICE_KEY=
TOURAPI_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOURAPI_MOBILE_APP=PlayGyeongju
# 게시글·댓글 즉시 검수 및 번역에 필요. 브라우저 환경변수에 넣지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 경상북도(47) / 경주시(130) 법정동 코드
TOURAPI_LDONG_REGN_CD=47
TOURAPI_LDONG_SIGNGU_CD=130

# sync 서비스가 TourAPI 를 다시 훑는 간격(일). 바뀐 건만 상세를 받으므로 짧게 잡아도
# 호출은 얼마 안 나가지만, 공사 데이터가 그리 자주 바뀌지 않아 주 1회면 충분하다.
SYNC_INTERVAL_DAYS=7

# 로컬 이미지 업로드 디렉터리와 최대 크기(byte)
# Local storage. On Vercel, omit this variable or use /tmp/uploads (not persistent).
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# 장소 검색 캐시(초)와 IP별 요청 제한
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW_SECONDS=60

# 로그인/관리자 인증 도입 전 로컬 검수 API용 임시 키
ADMIN_API_KEY=

# 쉼표로 구분한 프론트엔드 origin 목록
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 도슨트 음성(구글 Cloud Text-to-Speech). 키에 Text-to-Speech API 사용 권한이 있어야 한다.
# 없으면 도슨트 재생만 막히고 나머지 기능은 그대로 동작한다.
GOOGLE_TTS_API_KEY=
# 목소리와 말하기 속도 (비워 두면 ko-KR-Neural2-A / 0.95)
TTS_VOICE=ko-KR-Neural2-A
TTS_SPEAKING_RATE=0.95

SESSION_SECRET_KEY=
