# Kakao Developers > 앱 > 플랫폼 키에서 발급한 REST API 키
KAKAO_REST_API_KEY=

# Naver Developers > 애플리케이션 > 검색 API 인증 정보
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 앱(백엔드)이 붙는 MySQL 접속 정보. Docker Compose 에서는 DB_HOST 가 db 로 자동 override 된다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=play_gyeongju
DB_USER=play_gyeongju
DB_PASSWORD=

# MySQL 컨테이너 최초 기동 시 생성되는 DB/계정 (docker-compose db 서비스가 사용)
MYSQL_DATABASE=play_gyeongju
MYSQL_USER=play_gyeongju
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 공공데이터포털에서 발급받은 일반 인증키(Decoding 값)
TOURAPI_SERVICE_KEY=
TOURAPI_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOURAPI_MOBILE_APP=PlayGyeongju

# 경상북도(35) / 경주시(2) - areaBasedList2 용
TOURAPI_AREA_CODE=35
TOURAPI_SIGUNGU_CODE=2

# 경상북도(47) / 경주시(130) - searchFestival2 용 법정동 코드
TOURAPI_LDONG_REGN_CD=47
TOURAPI_LDONG_SIGNGU_CD=130

# 로컬 이미지 업로드 디렉터리와 최대 크기(byte)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# 장소 검색 캐시(초)와 IP별 요청 제한
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW_SECONDS=60

# 로그인/관리자 인증 도입 전 로컬 검수 API용 임시 키
ADMIN_API_KEY=

# 쉼표로 구분한 프론트엔드 origin 목록
CORS_ORIGINS=http://localhost:3000
